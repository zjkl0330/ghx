<?xml version="1.0" encoding="utf-8"?>
<!--
    启动图标（矢量）。

    为什么不用 @mipmap/ic_launcher_foreground：那是自适应图标的前景层，
    108dp 画布里内容只占中间 66dp；Android 12 的系统启动屏又会按 192dp 的圆去裁，
    两层缩下来猫只剩一小点。这里单独给一份「内容刚好占满 288 画布三分之二」的版本。

    形状是正圆而不是 App 图标的圆角方形：系统启动屏在没有 iconBackgroundColor 时
    会把图标裁成圆形，方形图标的四角会被切掉，正圆怎么裁都一致。
    白圆是为了深色启动屏上也能看见 —— 只留深色圆盘的话，深色底上等于隐形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- 白色圆底：直径 192，正好是系统允许的安全区 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,144a96,96 0 1,0 192,0a96,96 0 1,0 -192,0" />

    <!-- GitHub mark：16×16 放大 8.25 倍 = 132，在 192 的圆里四周留 30 -->
    <group
        android:translateX="78"
        android:translateY="78"
        android:scaleX="8.25"
        android:scaleY="8.25">
        <path
            android:fillColor="#141A22"
            android:pathData="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
    </group>
</vector>
